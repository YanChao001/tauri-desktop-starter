{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desktop: Rust + WebView",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path",
          "${workspaceFolder}/src-tauri/Cargo.toml",
          "--bin",
          "tauri-desktop-starter",
          "--no-default-features"
        ],
        "filter": { "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "frontend:dev",
      "env": { "RUST_BACKTRACE": "1" },
      "sourceLanguages": ["rust"]
    },
    {
      "name": "Frontend: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:1420",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "frontend:dev",
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
