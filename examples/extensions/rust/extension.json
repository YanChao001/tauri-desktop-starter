{
  "formatVersion": 3,
  "apiVersion": 2,
  "id": "example.rust-text",
  "version": "1.0.0",
  "name": "文本统计",
  "author": "Example author",
  "description": "Unicode case conversion and typed API 2 selected-data summaries using the Extism Rust PDK.",
  "commands": [
    {
      "id": "uppercase",
      "title": "Uppercase",
      "function": "uppercase",
      "inputFormat": "text",
      "resultFormat": "text",
      "permissions": ["text:read"]
    },
    {
      "id": "lowercase",
      "title": "Lowercase",
      "function": "lowercase",
      "inputFormat": "text",
      "resultFormat": "text",
      "permissions": ["text:read"]
    },
    {
      "id": "summarize",
      "title": "Summarize selected data",
      "function": "summarize",
      "inputFormat": "json",
      "resultFormat": "json",
      "permissions": ["text:read"]
    }
  ],
  "permissions": ["text:read"],
  "minHostVersion": "0.1.4",
  "optionalPermissions": ["files:read"],
  "network": []
}
