{
  "formatVersion": 3,
  "apiVersion": 2,
  "id": "starter.extension-lab",
  "version": "2.2.0",
  "name": "本地工作台",
  "author": "Tauri Desktop Starter",
  "description": "文本处理、CSV / JSON 预览与导出、轻量待办，以及按需文件与 HTTPS 示例。所有权限可选，本地工具离线可用。",
  "icon": "notebook",
  "commands": [
    {
      "id": "open",
      "title": "打开本地工作台",
      "function": "lab",
      "inputFormat": "json",
      "resultFormat": "view",
      "ui": {
        "sidebar": true,
        "window": true,
        "document": "main"
      },
      "permissions": []
    }
  ],
  "permissions": [],
  "minHostVersion": "0.1.5",
  "optionalPermissions": [
    "text:read",
    "files:read",
    "network:https",
    "storage"
  ],
  "network": [
    {
      "origin": "https://jsonplaceholder.typicode.com",
      "methods": [
        "GET"
      ]
    }
  ]
}
