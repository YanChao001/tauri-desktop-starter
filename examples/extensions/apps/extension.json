{
  "formatVersion": 3,
  "apiVersion": 2,
  "id": "starter.extension-lab",
  "version": "1.0.0",
  "name": "扩展实验室",
  "author": "Tauri Desktop Starter",
  "description": "文本分析、文件与 HTTPS、私有待办和偏好、图表与点灯解谜；完整源码演示宿主效果协议。",
  "icon": "puzzle",
  "commands": [
    {
      "id": "open",
      "title": "打开实验室 / Open lab",
