      "inputFormat": "json",
      "resultFormat": "view",
      "ui": {
        "sidebar": true,
        "window": true
      },
      "permissions": []
    }
  ],
  "permissions": [],
  "minHostVersion": "0.1.4",
  "optionalPermissions": [
    "text:read",
    "files:read",
    "network:https",
    "storage"
  ],
  "network": [
    {
      "origin": "https://jsonplaceholder.typicode.com",
      "methods": ["GET"]
    }
  ]
}
