{
  "formatVersion": 3,
  "apiVersion": 2,
  "id": "starter.extension-lab",
  "version": "2.3.1",
  "name": "本地工作台",
  "author": "Tauri Desktop Starter",
  "description": "用创意画布组织灵感，用数据透镜探索图表，用流程编排运行本地模拟；支持工作成果导出和文本、表格、待办等工具。交互可离线体验，文件与网络能力按需授权。",
  "icon": "notebook",
  "commands": [
    {
      "id": "open",
      "title": "打开本地工作台",
      "function": "lab",
      "inputFormat": "json",
      "resultFormat": "view",
      "ui": {
        "sidebar": true,
        "window": true,
        "document": "main"
      },
      "permissions": []
    }
  ],
  "permissions": [],
  "minHostVersion": "0.1.5",
  "optionalPermissions": [
    "text:read",
    "files:read",
    "network:https",
    "storage"
  ],
  "network": [
    {
      "origin": "https://jsonplaceholder.typicode.com",
      "methods": ["GET"]
    }
  ]
}
