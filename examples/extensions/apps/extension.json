{
  "formatVersion": 2,
  "apiVersion": 1,
  "id": "starter.extension-lab",
  "version": "1.0.0",
  "name": "扩展实验室",
  "author": "Tauri Desktop Starter",
  "description": "文本分析、文件与 HTTPS、数据视图、点灯解谜；完整源码演示侧栏、命令和独立窗口。",
  "inputFormat": "json",
  "resultFormat": "view",
  "icon": "puzzle",
  "ui": { "sidebar": true, "window": true },
  "commands": [
    { "id": "open", "title": "打开实验室 / Open lab", "function": "lab" }
  ],
  "permissions": ["text:read", "files:read", "network:https"],
  "allowedHosts": ["httpbin.org", "jsonplaceholder.typicode.com"]
}
