;; A small Extism ABI example. ASCII case conversion preserves all UTF-8 bytes.
(module
  (import "extism:host/env" "input_length" (func $length (result i64)))
  (import "extism:host/env" "input_load_u8" (func $load (param i64) (result i32)))
  (import "extism:host/env" "alloc" (func $alloc (param i64) (result i64)))
  (import "extism:host/env" "store_u8" (func $store (param i64 i32)))
  (import "extism:host/env" "output_set" (func $output (param i64 i64)))
  (func $convert (param $upper i32) (result i32)
    (local $n i64) (local $out i64) (local $i i64) (local $c i32)
    (local $min i32) (local $max i32) (local $offset i32)
    (local.set $min (select (i32.const 97) (i32.const 65) (local.get $upper)))
    (local.set $max (select (i32.const 122) (i32.const 90) (local.get $upper)))
    (local.set $offset (select (i32.const -32) (i32.const 32) (local.get $upper)))
    (local.set $n (call $length))
    (local.set $out (call $alloc (local.get $n)))
    (block $done
      (loop $next
        (br_if $done (i64.ge_u (local.get $i) (local.get $n)))
        (local.set $c (call $load (local.get $i)))
        (if (i32.and (i32.ge_u (local.get $c) (local.get $min)) (i32.le_u (local.get $c) (local.get $max)))
          (then (local.set $c (i32.add (local.get $c) (local.get $offset)))))
        (call $store (i64.add (local.get $out) (local.get $i)) (local.get $c))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br $next)))
    (call $output (local.get $out) (local.get $n))
    (i32.const 0))
  (func (export "uppercase") (result i32) (call $convert (i32.const 1)))
  (func (export "lowercase") (result i32) (call $convert (i32.const 0))))
