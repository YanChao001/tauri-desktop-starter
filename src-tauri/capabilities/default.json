{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力声明：前端只能调用这里显式允许的接口",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "window-state:default"
  ]
}
