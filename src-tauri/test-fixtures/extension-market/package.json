{
  "manifest": {
    "formatVersion": 2,
    "apiVersion": 1,
    "id": "market.text-tools",
    "version": "1.0.0",
    "name": "文本工具箱",
    "author": "Tauri Desktop Starter",
    "description": "使用实际 Extism Wasm 模块转换 Unicode 文本大小写，演示市场下载安装与显式文本授权。",
    "inputFormat": "text",
    "resultFormat": "text",
    "icon": "puzzle",
    "commands": [
      {
        "id": "uppercase",
        "title": "转为大写",
        "function": "uppercase"
      },
      {
        "id": "lowercase",
        "title": "转为小写",
        "function": "lowercase"
      }
    ],
    "permissions": [
      "text:read"
    ],
    "allowedHosts": []
  },
  "wasm": "AGFzbQEAAAA="
}
