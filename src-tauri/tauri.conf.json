{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Desktop Starter",
  "version": "0.1.7",
  "identifier": "com.starter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tauri Desktop Starter",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; frame-src extension-ui: http://extension-ui.localhost https://extension-ui.localhost; media-src 'self' blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://httpbin.org https://jsonplaceholder.typicode.com wss://echo.websocket.events",
      "devCsp": null
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["tdemo"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "resources": {
      "../resources/third-party/extism.LICENSE": "third-party/extism.LICENSE",
      "../resources/third-party/wasmtime.LICENSE": "third-party/wasmtime.LICENSE",
      "../resources/third-party/tauri.LICENSE": "third-party/tauri.LICENSE"
    },
    "fileAssociations": [
      {
        "ext": ["tdemo"],
        "name": "Tauri Desktop Starter Document",
        "description": "UTF-8 Tauri Desktop Starter document",
        "role": "Editor",
        "mimeType": "application/x-tdemo"
      }
    ],
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A complete desktop application starter",
    "copyright": "© 2026 Tauri Desktop Starter contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "template": "installer/installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp"
      },
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": ["installer/wix-ui.wxs"],
        "componentGroupRefs": ["StarterInstallerUI"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "publisher": "Tauri Desktop Starter contributors",
    "homepage": "https://yanchao001.github.io/tauri-desktop-starter/"
  }
}
